# Copy to .env and adjust. Nothing here is sent off-box.
# Next.js / drizzle read these on the server only — never prefix with NEXT_PUBLIC_.

DATABASE_URL=postgres://agentboard:agentboard@localhost:5432/agentboard
# Required: 32 random bytes, `openssl rand -base64 32`. Anything weaker is refused.
AUTH_SECRET=

# Sign-in is by a 6-digit code sent by email, through Resend; there are no
# passwords. Empty = nobody can sign in by the web: use `pnpm emergency-login`
# (deploy/README.md). Nothing is sent anywhere until they are set.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: most sign-in code emails the whole instance sends in an hour (default 60).
# LOGIN_CODE_MAX_SENDS_PER_HOUR=60

# Hard rule from the spec: no telemetry, analytics, or phone-home.
NEXT_TELEMETRY_DISABLED=1
