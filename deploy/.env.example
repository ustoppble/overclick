# Copy to deploy/.env and fill in. Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=
# Loopback port the reverse proxy talks to
OVERCLICK_PORT=3100
# Optional: secret shared with GitHub release webhooks (/api/github/release).
# Empty means the webhook refuses every call. Generate with openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Optional: sign-in by a 6-digit code sent by email, through Resend.
# Leave both empty to keep it off. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: most sign-in code emails the whole instance sends in an hour (default 60).
# LOGIN_CODE_MAX_SENDS_PER_HOUR=60
