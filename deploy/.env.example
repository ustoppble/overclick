# Copy to deploy/.env and fill in. Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=
# Loopback port the reverse proxy talks to
OVERCLICK_PORT=3100
# Optional: secret shared with GitHub release webhooks (/api/github/release).
# Empty means the webhook refuses every call. Generate with openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Sign-in is by a 6-digit code sent by email, through Resend, and nothing else.
# Empty = nobody can sign in by the web (use pnpm emergency-login, see
# deploy/README.md). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: most sign-in code emails the whole instance sends in an hour (default 60).
# LOGIN_CODE_MAX_SENDS_PER_HOUR=60
# Optional: the proxy in front is trusted for the caller's address (default 1 here).
# OVERCLICK_TRUSTED_PROXY=1
# Optional: behind Cloudflare, the header with the visitor's real address. Only set
# it once the server accepts traffic from Cloudflare alone (deploy/README.md).
# OVERCLICK_CLIENT_IP_HEADER=cf-connecting-ip
# The address people open the board at (scheme + domain, no path). It is the only
# origin an emailed link (team invitations) is built from; the request's Host is
# never used for that. Empty = invitation emails are not sent (the link is shown
# to copy). Example shape: https://board.your-domain
# OVERCLICK_PUBLIC_URL=
