  "--oc-tag-rfc-fg": "var(--oc-text-2)",
  "--oc-tap": "44px",
  "--oc-tap-min": "24px",
  "--oc-text-1": "#f7f7f8",
  "--oc-text-2": "rgb(var(--oc-white-rgb) / 0.64)",
  "--oc-text-3": "rgb(var(--oc-white-rgb) / 0.42)",
  "--oc-text-glow": "transparent",
  "--oc-todo": "var(--oc-text-2)",
  "--oc-todo-rgb": "var(--oc-white-rgb)",
  "--oc-vignette": "none",
  "--oc-warn": "var(--oc-text-2)",
  "--oc-warn-2-rgb": "var(--oc-white-rgb)",
  "--oc-warn-3-rgb": "var(--oc-white-rgb)",
  "--oc-warn-deep": "var(--oc-border-strong)",
  "--oc-warn-pip": "var(--oc-text-2)",
  "--oc-warn-rgb": "var(--oc-white-rgb)",
  "--oc-white-rgb": "255 255 255",
}
`;
